<UserControl x:Class="MagicWise.Desktop.Views.ParkDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Park name header -->
        <Border Grid.Row="0" Padding="16,12,16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <TextBlock Text="{Binding Park.Name}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Map -->
        <mapsui:MapControl x:Name="MapControl"
                           Grid.Row="1"
                           Loaded="MapControl_Loaded"
                           MouseMove="MapControl_MouseMove"
                           MouseLeave="MapControl_MouseLeave" />
    </Grid>
</UserControl>
