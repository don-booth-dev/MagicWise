<UserControl x:Class="MagicWise.Desktop.Views.WelcomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🎡"
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
            <TextBlock Text="MagicWise"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="Search for a park or select one from the list."
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
