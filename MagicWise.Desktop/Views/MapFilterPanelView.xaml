<UserControl x:Class="MagicWise.Desktop.Views.MapFilterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MagicWise.Desktop.ViewModels">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Selected park -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Park.Name}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Text="Show on map"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="Gray"
                   Margin="0,16,0,6" />

        <!-- Entity category tree: expand a category to see (and toggle) each
             individual item; the category checkbox selects/clears all of them. -->
        <TreeView Grid.Row="2"
                  ItemsSource="{Binding Categories}"
                  BorderThickness="0">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:EntityCategoryViewModel}"
                                          ItemsSource="{Binding Items}">
                    <CheckBox Content="{Binding DisplayName}"
                              IsThreeState="True"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Margin="0,2,0,2" />
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:EntityItemViewModel}">
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Margin="0,1,0,1" />
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
