<UserControl x:Class="MagicWise.Desktop.Views.ResortPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MagicWise.Desktop.ViewModels"
             xmlns:views="clr-namespace:MagicWise.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12,16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <TextBlock Text="Pick a Resort"
                       FontSize="20"
                       FontWeight="SemiBold" />
        </Border>

        <DockPanel Grid.Row="1">
            <!-- Search box (fixed at top) -->
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="16,12,16,4"
                     Padding="6,4"
                     FontSize="13">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 Search parks…" Foreground="Gray" Margin="4,0,0,0" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Scrollable area containing filter panel and park tree -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,16,16">
                    <!-- Filter facets -->
                    <views:FilterPanelView Margin="0,0,0,4" />

                    <!-- Divider separating the search/filter area from the resort
                         list below, so they don't visually run together. -->
                    <Border BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            Margin="0,8,0,8" />

                    <!-- Empty-state hint shown until a search or filter is active,
                         so the resort list isn't just blank space. -->
                    <TextBlock Text="Search for a resort or apply a filter above to see results."
                               Foreground="Gray"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="2,0,0,8"
                               Visibility="{Binding HasSearchOrFilterCriteria, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                    <!-- Destination (resort) list. Picking a resort here moves park
                         selection to the hamburger menu's park picker. -->
                    <ListBox ItemsSource="{Binding FilteredDestinations}"
                             BorderThickness="0"
                             Margin="0,0,0,4"
                             SelectionChanged="DestinationList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DestinationViewModel}">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Padding="2,4,2,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
