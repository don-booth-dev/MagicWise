<Application x:Class="MagicWise.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MagicWise.Desktop"
             xmlns:vm="clr-namespace:MagicWise.Desktop.ViewModels"
             xmlns:views="clr-namespace:MagicWise.Desktop.Views"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converter available application-wide -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Page DataTemplates: right-panel ContentControl resolves View from ViewModel type -->
            <DataTemplate DataType="{x:Type vm:ParkPickerViewModel}">
                <views:ParkPickerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParkDetailViewModel}">
                <views:ParkDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NoParkSelectedViewModel}">
                <views:NoParkSelectedView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
                <views:SettingsPageView />
            </DataTemplate>

            <!-- Left panel DataTemplates: swappable content above the fixed nav/attribution chrome -->
            <DataTemplate DataType="{x:Type vm:ResortFilterPanelViewModel}">
                <views:ResortFilterPanelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MapFilterPanelViewModel}">
                <views:MapFilterPanelView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
